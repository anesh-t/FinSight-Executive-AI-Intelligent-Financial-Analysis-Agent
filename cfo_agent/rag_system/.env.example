# ============================================================================
# RAG SYSTEM - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Direct PostgreSQL connection (for bulk operations)
DB_HOST=db.your-project-id.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# ----------------------------------------------------------------------------
# LLM API KEYS (choose one or both)
# ----------------------------------------------------------------------------
# OpenAI (for GPT-4, GPT-3.5-turbo)
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic (for Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Default LLM to use (openai or anthropic)
DEFAULT_LLM_PROVIDER=openai

# Model names
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229

# ----------------------------------------------------------------------------
# EMBEDDING MODEL
# ----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Model cache directory (optional)
TRANSFORMERS_CACHE=./models/cache

# ----------------------------------------------------------------------------
# DATA PATHS
# ----------------------------------------------------------------------------
JSON_FOLDER_PATH=./parsed_10k_json
OUTPUT_FOLDER=./output
LOGS_FOLDER=./logs

# ----------------------------------------------------------------------------
# PROCESSING PARAMETERS
# ----------------------------------------------------------------------------
# Batch size for database insertions
DB_BATCH_SIZE=500

# Top-k results for semantic search
DEFAULT_TOP_K=5

# Similarity threshold (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.3

# Maximum context length (tokens) for LLM
MAX_CONTEXT_LENGTH=8000

# ----------------------------------------------------------------------------
# QUERY CACHE SETTINGS
# ----------------------------------------------------------------------------
ENABLE_QUERY_CACHE=true
CACHE_TTL_HOURS=24
MAX_CACHE_SIZE=1000

# ----------------------------------------------------------------------------
# API SETTINGS (if running REST API)
# ----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
ENABLE_CORS=true

# ----------------------------------------------------------------------------
# LOGGING
# ----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text
LOG_TO_FILE=true

# ----------------------------------------------------------------------------
# DEVELOPMENT/PRODUCTION MODE
# ----------------------------------------------------------------------------
ENVIRONMENT=development  # development or production
DEBUG=true

# ----------------------------------------------------------------------------
# PERFORMANCE TUNING
# ----------------------------------------------------------------------------
# Number of worker processes for embedding generation
NUM_WORKERS=4

# Enable GPU acceleration (if available)
USE_GPU=false

# Connection pool size
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------------
# FEATURE FLAGS
# ----------------------------------------------------------------------------
ENABLE_HYBRID_SEARCH=true
ENABLE_FULL_TEXT_SEARCH=true
ENABLE_CONTEXT_EXPANSION=true
ENABLE_QUERY_REWRITING=false
ENABLE_RESPONSE_STREAMING=false

# ----------------------------------------------------------------------------
# MONITORING & TELEMETRY (Optional)
# ----------------------------------------------------------------------------
ENABLE_METRICS=false
METRICS_PORT=9090

# Sentry for error tracking (optional)
# SENTRY_DSN=your-sentry-dsn

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
